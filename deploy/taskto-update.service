# Installed by deploy/INSTALL.md (step 16). Runs deploy/taskto-update.sh once, from the timer.
[Unit]
Description=TaskTo.AI: update to the latest release
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/taskto-update
# An update that is stopped half way would leave the install between two versions: it has no
# time limit of its own, only its checks' (a health check that gives up, then the rollback).
TimeoutStartSec=infinity
