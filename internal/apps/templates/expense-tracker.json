{
  "template_version": 1,
  "id": "expense-tracker",
  "version": 1,
  "name": "Expense tracker",
  "description": "Record what you spend with a photo of the receipt, and see this month's total on your Home page.",
  "recommended_space": "private",
  "roles": { "installer": ["builder", "publisher", "user"], "members": ["user"] },
  "definition": {
    "screens": [
      {
        "name": "list",
        "root": "list-root",
        "components": [
          { "id": "list-root", "component": "Column", "children": ["list-title", "list-month", "list-new", "list-items"] },
          { "id": "list-title", "component": "Text", "text": "Expenses", "variant": "h2" },
          { "id": "list-month", "component": "Stat", "label": "Spent this month", "value": { "path": "/month_total" } },
          { "id": "list-new-label", "component": "Text", "text": "New expense" },
          {
            "id": "list-new",
            "component": "Button",
            "variant": "primary",
            "child": "list-new-label",
            "action": { "event": { "name": "new_expense" } }
          },
          { "id": "list-items", "component": "List", "children": { "componentId": "row", "path": "/items" } },
          { "id": "row", "component": "Column", "children": ["row-head", "row-foot"] },
          { "id": "row-head", "component": "Row", "justify": "spaceBetween", "align": "center", "children": ["row-description", "row-amount"] },
          { "id": "row-description", "component": "Text", "text": { "path": "description" } },
          { "id": "row-amount", "component": "Text", "text": { "path": "amount" } },
          { "id": "row-foot", "component": "Row", "justify": "spaceBetween", "align": "center", "children": ["row-when", "row-open"] },
          { "id": "row-when", "component": "Text", "text": { "path": "spent_on" }, "variant": "caption" },
          { "id": "row-open-label", "component": "Text", "text": "Open" },
          {
            "id": "row-open",
            "component": "Button",
            "variant": "borderless",
            "child": "row-open-label",
            "action": { "event": { "name": "open_expense", "context": { "id": { "path": "id" } } } }
          }
        ]
      },
      {
        "name": "new",
        "root": "new-root",
        "components": [
          {
            "id": "new-root",
            "component": "Column",
            "children": ["new-title", "new-description", "new-amount", "new-date", "new-category", "new-receipt", "new-actions"]
          },
          { "id": "new-title", "component": "Text", "text": "New expense", "variant": "h2" },
          { "id": "new-description", "component": "TextField", "label": "What was it for?", "value": { "path": "/draft/description" } },
          { "id": "new-amount", "component": "TextField", "label": "Amount", "variant": "number", "value": { "path": "/draft/amount" } },
          { "id": "new-date", "component": "DateTimeInput", "label": "Date", "enableDate": true, "value": { "path": "/draft/spent_on" } },
          {
            "id": "new-category",
            "component": "ChoicePicker",
            "label": "Category",
            "variant": "mutuallyExclusive",
            "displayStyle": "chips",
            "options": [
              { "label": "Food", "value": "food" },
              { "label": "Transport", "value": "transport" },
              { "label": "Lodging", "value": "lodging" },
              { "label": "Supplies", "value": "supplies" },
              { "label": "Other", "value": "other" }
            ],
            "value": { "path": "/draft/category" }
          },
          { "id": "new-receipt", "component": "PhotoInput", "field": "receipt", "label": "Photo of the receipt", "value": { "path": "/draft/receipt" } },
          { "id": "new-actions", "component": "Row", "children": ["new-back", "new-save"] },
          { "id": "new-back-label", "component": "Text", "text": "Back" },
          {
            "id": "new-back",
            "component": "Button",
            "child": "new-back-label",
            "action": { "event": { "name": "back_to_list" } }
          },
          { "id": "new-save-label", "component": "Text", "text": "Save expense" },
          {
            "id": "new-save",
            "component": "Button",
            "variant": "primary",
            "child": "new-save-label",
            "action": {
              "event": {
                "name": "add_expense",
                "context": {
                  "description": { "path": "/draft/description" },
                  "amount": { "path": "/draft/amount" },
                  "spent_on": { "path": "/draft/spent_on" },
                  "category": { "path": "/draft/category" },
                  "receipt": { "path": "/draft/receipt" }
                }
              }
            }
          }
        ]
      },
      {
        "name": "detail",
        "root": "detail-root",
        "record": true,
        "components": [
          {
            "id": "detail-root",
            "component": "Column",
            "children": ["detail-title", "detail-amount", "detail-date", "detail-category", "detail-receipt", "detail-actions"]
          },
          { "id": "detail-title", "component": "Text", "text": { "path": "/record/description" }, "variant": "h2" },
          { "id": "detail-amount", "component": "Stat", "label": "Amount", "value": { "path": "/record/amount" } },
          { "id": "detail-date", "component": "Stat", "label": "Date", "value": { "path": "/record/spent_on" } },
          { "id": "detail-category", "component": "Stat", "label": "Category", "value": { "path": "/record/_labels/category" } },
          { "id": "detail-receipt", "component": "Photos", "label": "Receipt", "value": { "path": "/record/receipt" } },
          { "id": "detail-actions", "component": "Row", "children": ["detail-back", "detail-delete"] },
          { "id": "detail-back-label", "component": "Text", "text": "Back" },
          {
            "id": "detail-back",
            "component": "Button",
            "child": "detail-back-label",
            "action": { "event": { "name": "back_to_list" } }
          },
          { "id": "detail-delete-label", "component": "Text", "text": "Delete" },
          {
            "id": "detail-delete",
            "component": "Button",
            "variant": "borderless",
            "child": "detail-delete-label",
            "action": { "event": { "name": "delete_expense", "context": { "id": { "path": "/record/id" } } } }
          }
        ]
      }
    ],
    "entry": "list",
    "collection": {
      "fields": [
        { "name": "description", "type": "string", "required": true, "max_length": 200 },
        { "name": "amount", "type": "number", "required": true, "min": 0 },
        { "name": "spent_on", "type": "date", "required": true },
        {
          "name": "category",
          "type": "choice",
          "required": true,
          "options": ["food", "transport", "lodging", "supplies", "other"],
          "option_labels": { "food": "Food", "transport": "Transport", "lodging": "Lodging", "supplies": "Supplies", "other": "Other" }
        },
        { "name": "receipt", "type": "attachment", "max_files": 3 }
      ]
    },
    "actions": {
      "new_expense": { "kind": "navigate", "screen": "new" },
      "open_expense": { "kind": "navigate", "screen": "detail" },
      "back_to_list": { "kind": "navigate", "screen": "list" },
      "add_expense": { "kind": "insert", "then": "list" },
      "delete_expense": { "kind": "delete", "then": "list" }
    },
    "summaries": {
      "month_total": { "kind": "sum", "field": "amount", "month_of": "spent_on" },
      "total": { "kind": "sum", "field": "amount" }
    },
    "contributions": {
      "widgets": [
        {
          "id": "spending",
          "title": "Expenses",
          "kind": "summaries",
          "size": "small",
          "summaries": [
            { "summary": "month_total", "label": "This month" },
            { "summary": "total", "label": "All time" }
          ]
        }
      ],
      "pin": { "label": "Expenses" }
    }
  }
}
