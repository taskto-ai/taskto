  {
    "name": "app_catalog",
    "description": "What a personal app may be made of: the components and their props, the functions, the collection's field types, the actions, the rules, and an example app. Read it before create_app or update_app.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "list_apps",
    "description": "List a space's personal apps (without their definitions); archived: true includes the ones taken offline. A list too long for one reply is cut short, with truncated: true and next_offset: call again with that offset for the rest.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "archived": {
          "type": "boolean"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "apps to skip, from a previous reply's next_offset; 0 by default"
        }
      },
      "required": ["space_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "show_app",
    "description": "Show an app with its definition: its screen, collection, actions and summaries, and its version.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "app_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the app, from list_apps"
        }
      },
      "required": ["space_id", "app_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "list_app_rows",
    "description": "Read an app's data: the rows the user may read (all of them, or only the ones they created, by their role in the app), oldest first, each with its id and the fields its collection declares. An offline app's rows are kept and read too. A list too long for one reply is cut short, with truncated: true and next_after: call again with after set to it for the rest.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "app_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the app, from list_apps"
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "description": "only rows after this row id, from a previous reply's next_after: rows added or removed meanwhile don't shift the pages"
        }
      },
      "required": ["space_id", "app_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "create_app",
    "description": "Save a new personal app in a space the user may write: a private space's apps are the user's, a shared space's are its members'. The server checks the definition against the catalog and says what is wrong if it doesn't fit.",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "definition": {
          "type": "object",
          "description": "what the app is made of: read app_catalog first. The server checks it strictly against the catalog.",
          "properties": {
            "components": {
              "type": "array",
              "minItems": 1,
              "maxItems": 300,
              "items": {
                "type": "object"
              },
              "description": "the screen: A2UI v0.9 components from app_catalog, each {\"id\", \"component\", …props}, one with the id \"root\""
            },
            "collection": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,39}$"
                      },
                      "type": {
                        "type": "string",
                        "enum": ["string", "number", "boolean", "date"]
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "max_length": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000,
                        "description": "string fields; 1000 if left out"
                      },
                      "min": {
                        "type": "number",
                        "description": "number fields"
                      },
                      "max": {
                        "type": "number",
                        "description": "number fields"
                      }
                    },
                    "required": ["name", "type"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["fields"],
              "additionalProperties": false
            },
            "actions": {
              "type": "object",
              "description": "event name → what it does; a Button's event must name one",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["insert", "update", "delete"]
                  }
                },
                "required": ["kind"],
                "additionalProperties": false
              }
            },
            "summaries": {
              "type": "object",
              "description": "values computed from the rows, at /<name> in the data model",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["count", "sum"]
                  },
                  "field": {
                    "type": "string",
                    "description": "the number field a sum adds"
                  }
                },
                "required": ["kind"],
                "additionalProperties": false
              }
            }
          },
          "required": ["components", "collection", "actions"],
          "additionalProperties": false
        }
      },
      "required": ["space_id", "name", "definition"],
      "additionalProperties": false
    }
  },
  {
