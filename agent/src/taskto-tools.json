[
  {
    "name": "list_spaces",
    "description": "List the spaces of the knowledge base and boards the user can read: their private space and the shared spaces they belong to, with whether they may write each.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "search_docs",
    "description": "Search the knowledge base: every space the user can read, or one space. Returns paths, titles and the passages that matched; read a document with read_doc.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": ["query"],
      "additionalProperties": false
    }
  },
  {
    "name": "list_docs",
    "description": "List the documents and files of a space, by path, a page at a time: pass the reply's \"next\" as \"after\" for the next page. Each has its size and \"versioned\": false for large files and audio and video, of which only the current version is kept.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "folder": {
          "type": "string",
          "description": "only what is in this folder"
        },
        "after": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": ["space_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "read_doc",
    "description": "Read a Markdown document (.md). Long documents come in pieces of 32 KiB: pass \"next_offset\" as \"offset\" for the next piece. \"version\" is what write_doc needs to change it.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["space_id", "path"],
      "additionalProperties": false
    }
  },
  {
    "name": "write_doc",
    "description": "Create or replace a Markdown document (.md) in a space the user may write. To create one, leave out base_version; to replace one, pass the version you read. The change is the user's, made by their agent, and kept in the history.",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "like notes/plan.md"
        },
        "content": {
          "type": "string"
        },
        "base_version": {
          "type": "string",
          "description": "the version from read_doc, to replace a document"
        },
        "message": {
          "type": "string",
          "maxLength": 200,
          "description": "what changed, for the history"
        }
      },
      "required": ["space_id", "path", "content"],
      "additionalProperties": false
    }
  },
  {
    "name": "list_boards",
    "description": "List a space's boards: its personal board, or its team boards.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        }
      },
      "required": ["space_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "list_cards",
    "description": "List a board's cards in board order (bodies shortened). Filter by column, assignee (\"user\" with assignee_id, \"agent\" or \"none\"), blocked, or text in the title or body.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "board_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the board, from list_boards"
        },
        "column": {
          "enum": ["backlog", "todo", "doing", "review", "done", "archived"]
        },
        "assignee": {
          "enum": ["user", "agent", "none"]
        },
        "assignee_id": {
          "type": "integer",
          "minimum": 1
        },
        "blocked": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": ["space_id", "board_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "show_card",
    "description": "Show a card with its whole body and its comment thread (the newest comments, if there are many).",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "board_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the board, from list_boards"
        },
        "card_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the card, from list_cards"
        }
      },
      "required": ["space_id", "board_id", "card_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "create_card",
    "description": "Add a card to a board. Only the title is required; it goes last in the backlog unless told otherwise.",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the space, from list_spaces"
        },
        "board_id": {
          "type": "integer",
          "minimum": 1,
          "description": "the board, from list_boards"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "description": "Markdown"
        },
        "column": {
          "enum": ["backlog", "todo", "doing", "review", "done"]
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based place in the column"
        },
        "assignee": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["user", "agent"]
                },
                "id": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "the user, for kind \"user\""
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "who the card is for: a member who can see the space, or the agent; null for nobody"
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "maxItems": 50,
          "description": "cards of the same board this one waits for"
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "description": "paths of documents in the same space"
        },
        "conversations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "maxItems": 50,
          "description": "conversation IDs; only the user's own conversations can be added"
        }
      },
      "required": ["space_id", "board_id", "title"],
      "additionalProperties": false
    }
  },
