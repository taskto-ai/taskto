  {
    "name": "browser_snapshot",
    "description": "Read a tab's page as text: its title, URL and visible text, with each link, button and field on a line that starts with its ref, such as [e12] button \"Sign in\". Use the refs with browser_click and browser_type, and take a new snapshot after the page changes. Password values are never shown, and frames (such as captchas) are named but not read.",
    "read_only": true,
    "conversation_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "tab": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{1,64}$",
          "description": "the tab's id, from browser_tabs or browser_open"
        },
        "browser": {
          "type": "string",
          "enum": ["personal", "testing"],
          "description": "personal (the default): the user's own browser, with their logins, which they can watch and take over; testing: a clean headless browser with no profile, emptied each time it starts, for trying apps"
        }
      },
      "required": ["tab"],
      "additionalProperties": false
    }
  },
  {
    "name": "browser_click",
