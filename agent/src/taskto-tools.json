      "additionalProperties": false
    }
  },
  {
    "name": "browser_tabs",
    "description": "List the open tabs of the user's browser: id, title, URL, and whether you opened it. Doesn't start the browser.",
    "read_only": true,
    "conversation_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "browser": {
          "type": "string",
          "enum": ["personal", "testing"],
          "description": "personal (the default): the user's own browser, with their logins, which they can watch and take over; testing: a clean headless browser with no profile, emptied each time it starts, for trying apps"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "browser_open",
    "description": "Open a URL in a new tab of the user's browser, starting it if it isn't running. Returns the tab; then read the page with browser_snapshot. Use the personal browser for the user's own accounts (it keeps their logins) and the testing one to try apps with nothing of the user's in it.",
    "read_only": false,
    "conversation_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
